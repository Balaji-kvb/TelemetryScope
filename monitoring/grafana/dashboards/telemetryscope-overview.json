{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "All Services Available",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetryscope-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=~\"telemetryscope-(demo|ingestion|processing|query)\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Ingestion RPS",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetryscope-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(telemetryscope_ingestion_requests_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Processing Events/sec",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetryscope-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(telemetryscope_processing_events_processed_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error Rate",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetryscope-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(telemetryscope_processing_events_processed_total{severity=\"ERROR\"}[5m])) / clamp_min(sum(rate(telemetryscope_processing_events_processed_total[5m])), 0.000001)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Service Availability",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetryscope-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"telemetryscope-(demo|ingestion|processing|query)\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Ingestion Traffic",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetryscope-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(telemetryscope_ingestion_requests_total[5m])) by (method, status)",
          "legendFormat": "{{method}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request Latency P95 (ms)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetryscope-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(telemetryscope_ingestion_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "Ingestion"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(telemetryscope_processing_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "Processing"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum(rate(telemetryscope_query_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "Query"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum(rate(telemetryscope_processing_db_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "Processing DB"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Events by Severity",
      "gridPos": {
        "h": 8,
